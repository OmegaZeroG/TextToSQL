# Postgres connection string. Local docker-compose default shown; for Neon
# use the connection string from your Neon dashboard (includes ?sslmode=require).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/texttosql

# Choose one provider: groq | openai | anthropic | gemini
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Only the key matching LLM_PROVIDER above is required
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Guardrail tuning
MAX_ROW_LIMIT=1000
MAX_SUBQUERY_DEPTH=3

# Comma-separated list of allowed frontend origins, or * for any
CORS_ORIGINS=*
