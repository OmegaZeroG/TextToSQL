# Choose one provider: groq | openai | anthropic | gemini
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Only the key matching LLM_PROVIDER above is required
GROQ_API_KEY=
# Optional extra Groq keys (separate accounts). Used in order when the one before is out
# of quota. GROQ_API_KEY2 ... GROQ_API_KEY9, or one comma-separated GROQ_API_KEYS.
GROQ_API_KEY2=
GROQ_API_KEY3=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Comma-separated list of allowed frontend origins, or * for any
CORS_ORIGINS=*

# Protects the LLM quota. 0 turns a limit off.
# Requests per minute from one client address
RATE_LIMIT_PER_MINUTE=10
# Requests per hour across all clients
RATE_LIMIT_PER_HOUR=120
# Reverse proxies in front of the app (Render: 1, local: 0)
TRUSTED_PROXY_HOPS=1

# Remember finished answers so a repeated question costs no tokens. 0 turns it off.
CACHE_MAX_ENTRIES=500
CACHE_TTL_SECONDS=86400
